        {
          "expr": "histogram_quantile(0.99, sum(rate(warego_reservation_duration_seconds_bucket[10s])) by (le))",
          "legendFormat": "p99 (Tail)"
        }
      ],
      "title": "Reservation Latency Percentiles (p50 / p95 / p99)",
      "type": "timeseries"
    },
